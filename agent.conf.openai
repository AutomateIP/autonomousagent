# Autonomous Agent Configuration File - OpenAI Testing
# This file configures the agent to use OpenAI's GPT models

[agent]
# System prompt file path
system_prompt = ./prompts/agent_system.prompt

# Logging levels (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Console logging level (what you see in terminal)
console_log_level = ERROR
# File logging level (what gets written to logs/)
file_log_level = INFO

# Maximum iterations for agent reasoning loop
max_iterations = 15

[llm]
# LLM provider
provider = openai

# Model to use
# Options: gpt-4 (8K), gpt-4-turbo (128K), gpt-4o (128K), gpt-3.5-turbo (16K)
model = gpt-4-turbo

# Temperature for LLM responses (0.0 to 1.0)
temperature = 0.7

# Maximum tokens for LLM responses
# Note: gpt-4-turbo supports up to 128K context, gpt-4 only 8K
max_tokens = 4096

[mcp]
# MCP configuration file path
config_file = ./mcp_config.json

# Itential MCP configuration file (if using itential-mcp)
itential_mcp_conf = ./itential-mcp.conf

# MCP connection timeout (seconds)
timeout = 120
