# Autonomous Agent Configuration File - Example
# Copy this to agent.conf and customize for your environment

[agent]
# System prompt file path
system_prompt = ./prompts/agent_system.prompt

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
log_level = INFO

# Maximum iterations for agent reasoning loop (prevents infinite loops)
max_iterations = 10

[llm]
# LLM provider (supports 100+ providers via LiteLLM)
# Common providers: anthropic, openai, gemini, bedrock, ollama
provider = anthropic

# Model to use
# LiteLLM supports provider-prefixed models (e.g., "gemini/gemini-pro") or standard names for major providers
#
# Anthropic (Claude):
#   claude-sonnet-4-5-20250929, claude-3-5-sonnet-20241022, claude-3-haiku-20240307
#
# OpenAI (GPT):
#   gpt-4, gpt-4-turbo, gpt-3.5-turbo
#
# Google Gemini:
#   gemini/gemini-pro, gemini/gemini-1.5-pro
#
# AWS Bedrock:
#   bedrock/anthropic.claude-v2, bedrock/anthropic.claude-3-sonnet-20240229-v1:0
#
# Ollama (local):
#   ollama/llama2, ollama/mistral, ollama/codellama
#
model = claude-sonnet-4-5-20250929

# Temperature for LLM responses (0.0 to 1.0)
# Lower = more focused/deterministic, Higher = more creative/varied
temperature = 0.7

# Maximum tokens for LLM responses
# Note: Increase for tasks that generate large content (e.g., HTML files, reports)
max_tokens = 8192

[mcp]
# MCP configuration file path (contains MCP server definitions)
config_file = ./mcp_config.json

# Itential MCP configuration file (if using itential-mcp)
itential_mcp_conf = ./itential-mcp.conf

# MCP connection timeout in seconds
timeout = 120
